{
  "name": "event-watcher",
  "version": "0.1.0",
  "description": "Sistema de alertas tempranas de disponibilidad de eventos (Ticketmaster -> Telegram)",
  "main": "dist/main.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run build && npm --prefix frontend run build",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.0",
    "@types/node-telegram-bot-api": "^0.64.7",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
