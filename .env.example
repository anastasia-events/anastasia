TICKETMASTER_API_KEY=
TELEGRAM_BOT_TOKEN=
# Username del bot (sin @), tal como aparece en su link t.me/<username> —
# lo necesita el deep link "Suscribirme por Telegram" del frontend.
TELEGRAM_BOT_USERNAME=
DATABASE_PATH=./data/event-watcher.sqlite

# API HTTP para el frontend
API_PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Lista de eventos vigilados (Ticketmaster + Crowder), con su info de
# display — ver config/watched-events.json. Solo cambiar esta ruta si
# querés usar un archivo distinto.
WATCHED_EVENTS_FILE=./config/watched-events.json

# Scheduler
POLLING_INTERVAL_SECONDS=15

# Rate limiting / reintentos contra la Discovery API de Ticketmaster
# (ajustable sin tocar código; valores por defecto pensados para el tier gratuito)
TICKETMASTER_MAX_REQUESTS_PER_SECOND=5
TICKETMASTER_REQUEST_TIMEOUT_MS=8000
TICKETMASTER_RETRY_MAX_ATTEMPTS=3
TICKETMASTER_RETRY_BASE_DELAY_MS=500

# Reservado para fase futura, no usado aún:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Proveedor secundario Crowder: parámetros globales (qué páginas/ítems
# vigilar, con sus fechas de ventana activa, vive en watched-events.json;
# ver scripts/validate-crowder-scrape.ts para listar los slugs disponibles
# en una página)
CROWDER_POLLING_INTERVAL_SECONDS=60
CROWDER_PAGE_CACHE_TTL_SECONDS=60

# Notificador WhatsApp (Cloud API de Meta) — opcional, si falta cualquiera
# de las 3 el canal WHATSAPP queda sin registrar (ver container.ts).
# El mensaje se manda como plantilla aprobada en Meta Business Manager, no
# como texto libre (ver scripts/validate-whatsapp-send.ts).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_API_VERSION=v20.0

# Notificador email (SendGrid) — opcional, si falta cualquiera de las 2 el
# canal EMAIL queda sin registrar. FROM_EMAIL tiene que ser un remitente
# verificado en SendGrid (ver scripts/validate-sendgrid-send.ts).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
