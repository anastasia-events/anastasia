TICKETMASTER_API_KEY=
TELEGRAM_BOT_TOKEN=
DATABASE_PATH=./data/event-watcher.sqlite

# IDs de evento de Ticketmaster a vigilar (separados por coma)
WATCHED_EVENT_IDS=

# Scheduler
POLLING_INTERVAL_SECONDS=15

# Rate limiting / reintentos contra la Discovery API de Ticketmaster
# (ajustable sin tocar código; valores por defecto pensados para el tier gratuito)
TICKETMASTER_MAX_REQUESTS_PER_SECOND=5
TICKETMASTER_REQUEST_TIMEOUT_MS=8000
TICKETMASTER_RETRY_MAX_ATTEMPTS=3
TICKETMASTER_RETRY_BASE_DELAY_MS=500

# Reservado para fase futura, no usado aún:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Proveedor secundario: eventos de Ticketmaster.co vendidos por Crowder
# (no viven en la Discovery API, se scrapea la página del evento).
# Opt-in: si CROWDER_WATCHED_ITEM_IDS está vacío, este scheduler ni se levanta.
CROWDER_EVENT_PAGE_URL=
# IDs de ítem = slug de "título-fecha" tal como aparece en la página
# (ver scripts/validate-crowder-scrape.ts para listarlos), separados por coma.
CROWDER_WATCHED_ITEM_IDS=
CROWDER_POLLING_INTERVAL_SECONDS=60
CROWDER_PAGE_CACHE_TTL_SECONDS=60
# Ventana activa (ISO 8601, opcional) — fuera de ella no se hace ningún
# request, para no pegarle a la página fuera de las fechas que importan.
CROWDER_WATCH_START_AT=
CROWDER_WATCH_END_AT=
